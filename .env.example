# Local demo configuration. Generate actual values with python scripts/setup_env.py.
# Docker Compose reads the root .env. Host development (pnpm dev) reads apps/api/.env.
# Copy placeholders into the appropriate private .env; never commit real credentials.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
AI_INTERNAL_SECRET=
WEB_ORIGIN=http://localhost:8080
WEB_PORT=8080
API_PORT=8000
DB_PORT=5433
# Derived by setup; database passwords are URL-encoded in these container URLs.
COMPOSE_DATABASE_URL=
COMPOSE_MIGRATION_DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
STALE_SECONDS=30

# SOS notification delivery. Keep false until recipients and sending services are verified.
# Setting true permits the server worker to submit queued notifications.
SOS_DELIVERY_ENABLED=false

# Resend API key from the Resend dashboard. Keep this secret and server-side.
RESEND_API_KEY=
# Sender email: use an address on your verified domain for delivery to other people.
# For a test to your Resend signup email only, use onboarding@resend.dev.
SOS_FROM_EMAIL=

# Twilio Account SID from your Twilio Console; begins with AC.
TWILIO_ACCOUNT_SID=
# Twilio Auth Token from the same account. Keep it secret; do not paste it into chat.
TWILIO_AUTH_TOKEN=
# Sender (From) number provided by Twilio, including +country code.
# This is NOT the recipient (To) number. Select recipients in Vyana's SOS settings.
# Product trials may assign different SMS/Voice senders and restrict message content.
TWILIO_FROM_NUMBER=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GEOAPIFY_API_KEY=
API_NINJAS_KEY=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8080/api/v1/integrations/google-health/callback
