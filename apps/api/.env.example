# Host API configuration for pnpm dev. Docker Compose uses the root .env instead.
# Copy this example to apps/api/.env and replace placeholders privately.
DATABASE_URL=postgresql://healthguard_app:YOUR_APP_DB_PASSWORD@127.0.0.1:5433/healthguard
MIGRATION_DATABASE_URL=postgresql://postgres:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:5433/healthguard
JWT_SECRET=
AI_INTERNAL_SECRET=
WEB_ORIGIN=http://localhost:5173
AI_URL=http://127.0.0.1:8001
HOST=127.0.0.1
PORT=8000
STALE_SECONDS=30
PUBLIC_REGISTRATION=false

# Server-side SOS delivery. Keep keys on the server, never in VITE_* variables.
# Keep false until recipients and sending services are verified.
# Setting true permits the server worker to submit queued notifications.
SOS_DELIVERY_ENABLED=false

# Resend API key from the Resend dashboard. Keep this secret.
RESEND_API_KEY=
# Sender email on your verified domain for delivery to other people.
# For a test to your Resend signup email only, use onboarding@resend.dev.
SOS_FROM_EMAIL=

# Twilio Account SID from your Twilio Console; begins with AC.
TWILIO_ACCOUNT_SID=
# Twilio Auth Token from the same account. Keep it secret; do not paste it into chat.
TWILIO_AUTH_TOKEN=
# Sender (From) number provided by Twilio, including +country code.
# This is NOT the recipient (To) number. Select recipients in Vyana's SOS settings.
# Product trials may assign different SMS/Voice senders and restrict message content.
TWILIO_FROM_NUMBER=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GEOAPIFY_API_KEY=
API_NINJAS_KEY=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:5173/api/v1/integrations/google-health/callback
# Background Google activity polling while the API is running (60–3600 seconds).
GOOGLE_HEALTH_SYNC_SECONDS=120
